pkgname=kutu-memory
pkgver=0.1.0
pkgrel=1
pkgdesc="kutu OS Tier-0 memory stack: zswap, MGLRU, journald, I/O scheduler tuning"
arch=(any)
url="https://kutu.so"
license=(MIT)
depends=(systemd grub)
install=kutu-memory.install
package() {
  install -Dm644 "$startdir/sysctl/60-kutu-memory.conf" -t "$pkgdir/etc/sysctl.d/"
  install -Dm644 "$startdir/grub/99-kutu-memory.cfg" -t "$pkgdir/etc/default/grub.d/"
  install -Dm755 "$startdir/usr/bin/kutu-mglru-init" "$startdir/usr/bin/kutu-damon" -t "$pkgdir/usr/bin/"
  install -Dm644 "$startdir/systemd/kutu-mglru.service" "$startdir/systemd/kutu-damon.service" -t "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 "$startdir/journald/99-kutu.conf" -t "$pkgdir/etc/systemd/journald.conf.d/"
  install -Dm644 "$startdir/udev/60-kutu-ioschedulers.rules" -t "$pkgdir/usr/lib/udev/rules.d/"
  install -Dm644 "$startdir/oomd/oomd.conf.d/99-kutu.conf" -t "$pkgdir/etc/systemd/oomd.conf.d/"
  install -Dm644 "$startdir/oomd/user.slice.d/50-kutu-oomd.conf" -t "$pkgdir/etc/systemd/system/user.slice.d/"
  install -Dm644 "$startdir/oomd/avoid/pipewire.service.d/99-kutu-avoid.conf" -t "$pkgdir/etc/systemd/system/pipewire.service.d/"
  install -Dm644 "$startdir/oomd/avoid/wireplumber.service.d/99-kutu-avoid.conf" -t "$pkgdir/etc/systemd/system/wireplumber.service.d/"
  install -Dm644 "$startdir/oomd/avoid/xdg-desktop-portal.service.d/99-kutu-avoid.conf" -t "$pkgdir/etc/systemd/system/xdg-desktop-portal.service.d/"
  install -Dm755 "$startdir/usr/bin/kutu-reset" -t "$pkgdir/usr/bin/"
}
