regen_grub() {
  [ -d /boot/grub ] && grub-mkconfig -o /boot/grub/grub.cfg || true
}

post_install() {
  systemctl enable kutu-memory-early.service kutu-damon.service systemd-oomd.service 2>/dev/null || true
  regen_grub
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable --now kutu-damon.service kutu-memory-early.service systemd-oomd.service 2>/dev/null || true
  /usr/bin/kutu-damon stop 2>/dev/null || true
}

post_remove() {
  regen_grub
}
