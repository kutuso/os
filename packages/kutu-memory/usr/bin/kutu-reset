#!/usr/bin/env bash
set -euo pipefail
echo "== kutu-reset: reverting kutu memory tuning to stock Arch defaults =="
systemctl disable --now kutu-damon.service kutu-memory-early.service systemd-oomd.service 2>/dev/null || true
/usr/bin/kutu-damon stop 2>/dev/null || true

sysctl -w vm.swappiness=60 vm.page-cluster=3 vm.watermark_scale_factor=10 \
  vm.watermark_boost_factor=15000 vm.dirty_background_ratio=10 vm.dirty_ratio=20 >/dev/null
install -Dm644 /dev/null /etc/sysctl.d/70-kutu-disabled.conf
cat > /etc/sysctl.d/70-kutu-disabled.conf <<'EOF'
vm.swappiness = 60
vm.page-cluster = 3
vm.watermark_scale_factor = 10
vm.watermark_boost_factor = 15000
vm.dirty_background_ratio = 10
vm.dirty_ratio = 20
EOF

[ -e /sys/kernel/mm/lru_gen/enabled ] && printf '%s' 0x0007 > /sys/kernel/mm/lru_gen/enabled
[ -e /sys/kernel/mm/lru_gen/min_ttl_ms ] && printf '%s' 0 > /sys/kernel/mm/lru_gen/min_ttl_ms
[ -e /sys/module/zswap/parameters/enabled ] && printf '%s' Y > /sys/module/zswap/parameters/enabled
[ -e /sys/module/zswap/parameters/max_pool_percent ] && printf '%s' 20 > /sys/module/zswap/parameters/max_pool_percent
[ -e /sys/module/zswap/parameters/zpool ] && printf '%s' '' > /sys/module/zswap/parameters/zpool 2>/dev/null || true

disable_dropin() {
  if [ -f "$1" ]; then
    mv "$1" "$1.disabled"
    echo "kutu-reset: disabled $1 (package upgrades restore it; re-run kutu-reset after upgrades)"
  fi
  return 0
}
disable_dropin /etc/systemd/system/user@.service.d/50-kutu-oomd.conf
disable_dropin /etc/systemd/oomd.conf.d/99-kutu.conf
disable_dropin /etc/systemd/journald.conf.d/99-kutu.conf
if disable_dropin /usr/lib/udev/rules.d/60-kutu-ioschedulers.rules; then
  udevadm control --reload 2>/dev/null || true
fi

rm -f /etc/systemd/system/user.slice.d/50-kutu.conf
rm -f /etc/kutu/apps.d/firefox.conf

if [ -f /etc/default/grub.d/99-kutu-memory.cfg ]; then
  mv /etc/default/grub.d/99-kutu-memory.cfg /etc/default/grub.d/99-kutu-memory.cfg.disabled
  grub-mkconfig -o /boot/grub/grub.cfg 2>/dev/null || echo "note: grub-mkconfig failed; cmdline reverts on next grub-mkconfig"
fi
systemctl daemon-reload 2>/dev/null || true
echo "kutu-reset: done. Reboot for full effect. Undo: rm /etc/sysctl.d/70-kutu-disabled.conf, rename the *.disabled files back, then: systemctl enable --now kutu-memory-early kutu-damon systemd-oomd"
