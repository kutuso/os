pkgname=yay
pkgver=13.0.1
pkgrel=1
pkgdesc="Yet another yogurt: pacman wrapper and AUR helper written in Go"
arch=(x86_64)
url="https://github.com/Jguer/yay"
license=(MIT)
depends=(pacman sudo git glibc)
makedepends=(go)
source=("https://github.com/Jguer/yay/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('b77454bce87110180a1b6664c2d260de78124c9894b71101610ba84f551eb0d0')

build() {
  cd "$pkgname-$pkgver"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -v -ldflags "-X main.yayVersion=${pkgver} -s -w" -o yay
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 yay -t "$pkgdir/usr/bin/"
  install -Dm644 completions/bash -t "$pkgdir/usr/share/bash-completion/completions/yay"
  install -Dm644 completions/zsh -t "$pkgdir/usr/share/zsh/site-functions/_yay"
  install -Dm644 completions/fish -t "$pkgdir/usr/share/fish/vendor_completions.d/yay.fish"
}
