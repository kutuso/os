# kutu OS Kernel Parameters - Intel Lunar Lake / Arc Optimized
# Additional parameters for Intel systems
# These are appended to the base cmdline by first-boot-setup.sh

# Intel IOMMU for GPU memory access
intel_iommu=on
iommu=pt

# Intel i915/Xe Graphics - GuC/HuC firmware scheduling
i915.enable_guc=3
i915.enable_rc6=1
i915.enable_fbc=1

# Intel P-State (active mode for hardware-managed frequencies)
intel_pstate=active

# C-state management for balanced latency/power
# Use max_cstate=2 for C1/C1E (low latency, moderate power saving)
# Use max_cstate=1 for C1 only (lowest latency, higher idle power)
intel_idle.max_cstate=2

# Optional: Disable turbo boost if thermal throttling occurs
# Uncomment after testing under sustained load for 1-4 hours
#intel_pstate=no_turbo
