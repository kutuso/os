# kutu OS Kernel Configuration for AI/ML Workloads
# Optimized for distributed AI inference on AMD Strix Halo and Intel Lunar Lake
# Kernel 6.12+ required (6.14+ recommended for AMD)
#
# This is a configuration fragment to be merged with a base Arch kernel config
# Usage: scripts/kconfig/merge_config.sh .config configs/kernel/config-ai-optimized
#
# For detailed explanations, see: docs/KERNEL.md

###############################################################################
# Hardware Support (6.12+ kernel required)
###############################################################################

# Core DRM and Graphics Infrastructure
CONFIG_DRM=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_TTM=y
CONFIG_DRM_BUDDY=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

# Intel Lunar Lake Support
CONFIG_DRM_XE=m
CONFIG_DRM_XE_DISPLAY=y
CONFIG_DRM_I915=m
CONFIG_DRM_I915_GVT=n
CONFIG_DRM_I915_GVT_KVMGT=n

# Intel NPU (Neural Processing Unit)
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_IVPU=m

# Intel MEI (Management Engine Interface) - required for NPU
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m
CONFIG_INTEL_MEI_TXE=m

# AMD Strix Halo Support
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_DCN=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMDGPU_SI=y

# Firmware loading
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""

###############################################################################
# Memory Management - Critical for Multi-Model AI Workloads
###############################################################################

# Huge Pages - Essential for reducing TLB pressure
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

# Memory Compaction - Prevents fragmentation
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_PAGE_MIGRATION=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_BALLOON_COMPACTION=y

# Modern SLUB Allocator
CONFIG_SLUB=y
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_SLUB_CPU_PARTIAL=y

# Heterogeneous Memory Management - Critical for GPU unified memory
CONFIG_HMM_MIRROR=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_MMU_NOTIFIER=y

# NUMA Support and Emulation
# Enable even on single-socket systems for memory partitioning and testing
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_NUMA_BALANCING_DEFAULT_ENABLED=y
CONFIG_NUMA_EMU=y
CONFIG_NODES_SHIFT=6

# Memory Zones
CONFIG_ZONE_DMA=y
CONFIG_ZONE_DMA32=y
CONFIG_ZONE_DEVICE=y

# Memory Control Groups
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y

###############################################################################
# IOMMU - GPU Memory Access and DMA
###############################################################################

CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_API=y
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=y

# Intel IOMMU
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_SVM=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_INTEL_IOMMU_SCALABLE_MODE_DEFAULT_ON=y

# AMD IOMMU
CONFIG_AMD_IOMMU=y
CONFIG_AMD_IOMMU_V2=y

###############################################################################
# Low Latency and Real-Time Configuration
###############################################################################

# Preemption Model - CONFIG_PREEMPT for low latency
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPT_RCU=y
CONFIG_PREEMPT_NOTIFIERS=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# Optional: Enable for hard real-time (5-10% throughput cost)
# CONFIG_PREEMPT_RT=y

# High Resolution Timers - Nanosecond precision
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y

# Tickless Operation - Reduce timer interrupts
CONFIG_NO_HZ_COMMON=y
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CONTEXT_TRACKING=y
CONFIG_CONTEXT_TRACKING_FORCE=n

# RCU Optimizations
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=n
CONFIG_RCU_LAZY=y

# IRQ Threading - Enable interrupt prioritization
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_GENERIC_IRQ_MIGRATION=y

# Disable RT Group Scheduling (causes latency spikes)
CONFIG_RT_GROUP_SCHED=n

###############################################################################
# CPU Frequency Scaling - Schedutil Governor
###############################################################################

CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
# CONFIG_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set

# Intel P-State Driver
CONFIG_X86_INTEL_PSTATE=y

# AMD P-State Driver (CPPC)
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_UT=m

###############################################################################
# CPU Idle States - C-State Management
###############################################################################

CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CPU_IDLE_GOV_HALTPOLL=y

# Intel Idle Driver
CONFIG_INTEL_IDLE=y

###############################################################################
# Thermal Management - Prevent Throttling
###############################################################################

CONFIG_THERMAL=y
CONFIG_THERMAL_HWMON=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_THERMAL_DEFAULT_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_FAIR_SHARE=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_BANG_BANG=y
CONFIG_THERMAL_GOV_USER_SPACE=y

# ACPI Thermal
CONFIG_ACPI=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_PROCESSOR_AGGREGATOR=m
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_DOCK=y
CONFIG_ACPI_CPU_FREQ_PSS=y

# x86 Thermal
CONFIG_X86_PKG_TEMP_THERMAL=y
CONFIG_X86_THERMAL_VECTOR=y

# Intel PowerClamp (emergency thermal protection)
CONFIG_INTEL_POWERCLAMP=m

# Intel HWP (Hardware P-States)
CONFIG_X86_HWP_EPP=y

###############################################################################
# Network Optimization - P2P Distributed Workloads
###############################################################################

# Core Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# TCP/IP Optimizations
CONFIG_SYN_COOKIES=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_TCP_CONG_CUBIC=y

# Low-Latency Socket Polling
CONFIG_NET_RX_BUSY_POLL=y

# Packet Scheduler
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# Network Device Support
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

###############################################################################
# RDMA Support (Optional - for high-performance clustering)
###############################################################################

CONFIG_INFINIBAND=m
CONFIG_INFINIBAND_USER_MAD=m
CONFIG_INFINIBAND_USER_ACCESS=m
CONFIG_INFINIBAND_ADDR_TRANS=y
CONFIG_INFINIBAND_IPOIB=m
CONFIG_INFINIBAND_IPOIB_CM=y
CONFIG_INFINIBAND_SRP=m
CONFIG_INFINIBAND_ISER=m

# Mellanox Drivers (common in AI clusters)
CONFIG_MLX4_CORE=m
CONFIG_MLX4_EN=m
CONFIG_MLX4_INFINIBAND=m
CONFIG_MLX5_CORE=m
CONFIG_MLX5_CORE_EN=y
CONFIG_MLX5_INFINIBAND=m

###############################################################################
# Power Management - Balanced for 24/7 Operation
###############################################################################

CONFIG_PM=y
CONFIG_PM_SLEEP=n
CONFIG_PM_AUTOSLEEP=n
CONFIG_PM_WAKELOCKS=n
CONFIG_HIBERNATION=n
CONFIG_PM_STD_PARTITION=""

# PCIe ASPM - Enable for power savings, disable if stability issues
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_DEFAULT=y
CONFIG_PCIEASPM_POWERSAVE=y
CONFIG_PCIEASPM_POWER_SUPERSAVE=n
CONFIG_PCIEASPM_PERFORMANCE=n

# Workqueue Power Efficient
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=n

# CPU Frequency
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n

###############################################################################
# Storage and Filesystem
###############################################################################

# NVMe Support
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y
CONFIG_NVME_HWMON=y

# Block Layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_BLK_WBT=y
CONFIG_BLK_WBT_MQ=y

# I/O Schedulers
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_F2FS_FS=y

###############################################################################
# Disable Debugging for Performance
###############################################################################

# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_LOCKDEP is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_LATENCYTOP is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_KGDB is not set
# CONFIG_STACK_TRACER is not set

###############################################################################
# Security vs Performance Tradeoffs
###############################################################################

# Core Security (keep enabled)
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y

# Optional: Disable for performance (use with caution)
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set

# Kernel Hardening
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
CONFIG_INIT_ON_FREE_DEFAULT_ON=n

###############################################################################
# Control Groups (cgroups) - For containerized AI workloads
###############################################################################

CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y

###############################################################################
# Namespaces - For containers
###############################################################################

CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

###############################################################################
# Additional Performance Features
###############################################################################

# Kernel Samepage Merging (useful for multiple identical models)
CONFIG_KSM=y

# Swap (minimal, prefer memory)
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZPOOL=y
CONFIG_ZSMALLOC=y

# Profiling (disable for production)
CONFIG_PROFILING=y
CONFIG_PERF_EVENTS=y

# CPU isolation
CONFIG_CPU_ISOLATION=y

###############################################################################
# Module Support
###############################################################################

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_COMPRESS_NONE=y
