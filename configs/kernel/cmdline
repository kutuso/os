# kutu OS Kernel Command Line Parameters
# Optimized for distributed AI inference workloads
# Kernel 6.12+ required (6.14+ recommended for AMD)
#
# This file contains COMMON parameters for all systems.
# Hardware-specific parameters are auto-detected and applied at boot.
# See: configs/kernel/cmdline.amd and configs/kernel/cmdline.intel
#
# Documentation: docs/KERNEL.md

###############################################################################
# Boot Configuration
###############################################################################

# Root filesystem (will be replaced during installation)
root=/dev/sda2 rw

# Boot splash and console
quiet splash loglevel=3

###############################################################################
# CPU Optimization and Isolation
###############################################################################

# Disable security mitigations for 10-30% performance gain
# WARNING: Only for isolated AI nodes, not internet-facing servers
mitigations=off

# CPU Core Isolation for Dedicated Inference
# Reserve CPU 0 for system tasks, isolate 1-15 for AI workloads
# Adjust based on your CPU count (assumes 16-core minimum)
nohz_full=1-31
rcu_nocbs=1-31
isolcpus=managed_irq,domain,1-31
irqaffinity=0

# Thread IRQs for better interrupt control
threadirqs

###############################################################################
# Memory Management - Critical for Multi-Model Workloads
###############################################################################

# Transparent Huge Pages - Use madvise for application control
# Prevents latency spikes from automatic compaction
transparent_hugepage=madvise

# Huge page configuration
hugepagesz=2M
default_hugepagesz=2M
hugepages=2048

# NUMA Emulation - Enables memory partitioning on single-socket systems
# Useful for cache locality optimization and testing NUMA-aware code
# Creates 4 fake NUMA nodes
numa=fake=4
numa_balancing=enable

###############################################################################
# NVMe and Storage Optimization
###############################################################################

# Disable NVMe power saving for consistent latency
nvme_core.default_ps_max_latency_us=0

# Disable I/O add_random (entropy) for performance
libata.force=noncq

###############################################################################
# Scheduler and Preemption
###############################################################################

# Use full preemption for low latency (<100μs worst-case)
# CONFIG_PREEMPT must be enabled in kernel
preempt=full

# Timer frequency (requires CONFIG_HZ_1000=y)
# Provides 1ms scheduling granularity

###############################################################################
# Power Management
###############################################################################

# Disable watchdog for slight performance gain
nowatchdog
nmi_watchdog=0

# PCIe ASPM - Keep enabled for thermal management
# Disable (pcie_aspm=off) only if experiencing device issues
pcie_aspm=performance

###############################################################################
# System Tuning
###############################################################################

# Increase maximum PID limit
pid_max=4194304

# Reduce boot time
systemd.show_status=false

# Disable audit framework for performance
audit=0

###############################################################################
# Hardware-Specific Parameters
# Uncomment based on your system - or let first-boot-setup.sh detect
###############################################################################

# AMD Strix Halo / RDNA Graphics
#amdgpu.gttsize=131072
#ttm.pages_limit=33554432
#amd_iommu=on
#iommu=pt
#amdgpu.dpm=1
#amdgpu.ppfeaturemask=0xffffffff

# Intel Lunar Lake / Arc Graphics
#intel_iommu=on
#iommu=pt
#i915.enable_guc=3
#i915.enable_rc6=1
#i915.enable_fbc=1

# NVIDIA (if installed)
#nvidia-drm.modeset=1
#nvidia.NVreg_PreserveVideoMemoryAllocations=1

###############################################################################
# Advanced Tuning (Optional - test thoroughly)
###############################################################################

# CPU Frequency - Force performance governor at boot
#cpufreq.default_governor=performance

# Disable turbo boost if thermal throttling occurs
# Intel: intel_pstate=no_turbo
# AMD: amd_pstate=passive

# Limit C-states for lower latency (higher idle power)
#intel_idle.max_cstate=1
#processor.max_cstate=1

# CPU frequency scaling driver selection
# Intel (modern): intel_pstate=active (default, recommended)
# AMD (Zen2+): amd_pstate=active initcall_blacklist=acpi_cpufreq_init
